# Copy to .env and fill in. NEVER commit .env. Generate secrets with:  openssl rand -base64 48

# --- Database (docker compose creates MySQL with these) ---
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-another-strong-password

# --- Security ---
# Required. At least 32 random characters. Changing it signs everyone out.
JWT_SECRET=
# Only needed if the web app and API are on DIFFERENT origins (comma separated, no trailing slash).
CORS_ALLOWED_ORIGINS=

# --- Public URLs (used in emails) ---
APP_PUBLIC_URL=http://localhost:8081
APP_PUBLIC_API_URL=
WEB_PORT=8081

# --- First admin (created once, only if that email does not exist yet) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (leave SPRING_MAIL_HOST empty to disable sending) ---
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=FerryWala <no-reply@yourdomain.com>
# Set true only after email sending works, so users must confirm before signing in.
REQUIRE_EMAIL_VERIFICATION=false

# --- AI Concierge (optional) ---
# With these empty the Concierge runs fully on built-in server rules and says so in the UI.
# The LLM is used ONLY to reword already-verified answers; it gets no tools, secrets or contact details.
# The built-in provider speaks the Anthropic Messages API (POST {base-url}/v1/messages). Other providers need a
# new LlmProvider implementation. Both the key AND the model name must be set to enable it.
CONCIERGE_NAME=AI Concierge
CONCIERGE_LLM_API_KEY=
CONCIERGE_LLM_MODEL=
# Optional; defaults to https://api.anthropic.com
CONCIERGE_LLM_BASE_URL=
CONCIERGE_LLM_TIMEOUT_MS=8000
# Days before Concierge chat history is deleted automatically (users can also delete it any time).
CONCIERGE_RETENTION_DAYS=30
# Shown to users when they ask for a human. Leave empty to hide.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# --- Demand engine ---
DEMAND_TIME_ZONE=Asia/Kolkata

# --- Frontend dev only (frontend/.env.local) ---
# DEV_API_TARGET=http://localhost:8080
# VITE_API_BASE_URL=   # only if the API is on another origin
# VITE_WS_URL=
